generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @default(cuid())
  username      String         @unique
  pinHash       String
  createdAt     DateTime       @default(now())
  tasks         Task[]         @relation("Author")
  teams         TeamMember[]
  priorities    Priority[]
  statuses      Status[]
  categories    Category[]
  notifications Notification[]
  mutedProjects MutedProject[]
}

model Team {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  members   TeamMember[]
  projects  Project[]
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("member")
  createdAt DateTime @default(now())

  @@unique([teamId, userId])
  @@index([userId])
}

model Project {
  id            String         @id @default(cuid())
  name          String
  color         String?
  context       String?        @db.Text
  teamId        String?
  team          Team?          @relation(fields: [teamId], references: [id])
  ownerId       String?
  tasks         Task[]
  mutedBy       MutedProject[]

  @@unique([name, ownerId])
  @@index([ownerId])
}

model MutedProject {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, projectId])
  @@index([userId])
}

model Priority {
  id      String  @id @default(cuid())
  name    String
  rank    Int     @default(0)
  color   String?
  ownerId String
  user    User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@unique([name, ownerId])
  @@index([ownerId])
}

model Status {
  id      String  @id @default(cuid())
  name    String
  rank    Int     @default(0)
  color   String?
  ownerId String
  user    User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@unique([name, ownerId])
  @@index([ownerId])
}

model Category {
  id      String  @id @default(cuid())
  name    String
  color   String?
  ownerId String
  user    User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@unique([name, ownerId])
  @@index([ownerId])
}

model Task {
  id            String         @id @default(cuid())
  title         String
  notes         String?        @db.Text
  dueDate       DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  projectId     String
  project       Project        @relation(fields: [projectId], references: [id])
  authorId      String
  author        User           @relation("Author", fields: [authorId], references: [id])
  priorityId    String
  priority      Priority       @relation(fields: [priorityId], references: [id])
  statusId      String
  status        Status         @relation(fields: [statusId], references: [id])
  categoryId    String?
  category      Category?      @relation(fields: [categoryId], references: [id])
  location      String?
  attention     Boolean        @default(false)
  attentionNote String?        @db.Text
  deletedAt     DateTime?
  archivedAt    DateTime?
  notifications Notification[]

  @@index([projectId])
  @@index([deletedAt])
  @@index([archivedAt])
  @@index([statusId])
  @@index([priorityId])
  @@index([authorId])
  @@index([categoryId])
  @@index([attention])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([taskId])
  @@index([isRead])
  @@index([createdAt])
}

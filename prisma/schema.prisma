generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  pinHash   String
  createdAt DateTime @default(now())
  tasks     Task[]   @relation("Author")
}

model Project {
  id    String  @id @default(cuid())
  name  String  @unique
  color String?
  tasks Task[]
}

model Priority {
  id    String  @id @default(cuid())
  name  String  @unique
  rank  Int     @default(0)
  color String?
  tasks Task[]
}

model Status {
  id    String  @id @default(cuid())
  name  String  @unique
  rank  Int     @default(0)
  color String?
  tasks Task[]
}

model Category {
  id    String  @id @default(cuid())
  name  String  @unique
  color String?
  tasks Task[]
}

model Task {
  id         String    @id @default(cuid())
  title      String
  notes      String?   @db.Text
  dueDate    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id])
  authorId   String
  author     User      @relation("Author", fields: [authorId], references: [id])
  priorityId String
  priority   Priority  @relation(fields: [priorityId], references: [id])
  statusId   String
  status     Status    @relation(fields: [statusId], references: [id])
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  @@index([projectId])
  @@index([statusId])
  @@index([priorityId])
  @@index([authorId])
  @@index([categoryId])
}
